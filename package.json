{
  "name": "short-studio-server",
  "version": "2.5.0",
  "description": "Short Studio Server: automated short-video production and publishing (Arabic + English), with a REST API and Model Context Protocol (MCP) interface.",
  "main": "index.js",
  "packageManager": "pnpm@11.7.0",
  "bugs": "https://github.com/3bud-ZC/Abud-Shorts-Engine/issues",
  "homepage": "https://github.com/3bud-ZC/Abud-Shorts-Engine",
  "scripts": {
    "build": "npm run typecheck && rimraf dist && tsc --project tsconfig.build.json && vite build",
    "dev": "vite build --watch | node --watch -r ts-node/register src/index.ts ",
    "start": "node dist/index.js",
    "test": "vitest",
    "prepublishOnly": "npm run build && echo \"#!/usr/bin/env node\n$(cat dist/index.js)\" > dist/index.js && chmod +x dist/index.js",
    "publish:docker": "npm run publish:docker:normal && npm run publish:docker:cuda && npm run publish:docker:tiny",
    "publish:docker:cuda": "docker buildx build --platform linux/amd64 -t gyoridavid/short-video-maker:latest-cuda -t gyoridavid/short-video-maker:${npm_package_version}-cuda -f main-cuda.Dockerfile --push ./",
    "publish:docker:normal": "docker buildx build --platform linux/amd64,linux/arm64 -t gyoridavid/short-video-maker:latest -t gyoridavid/short-video-maker:${npm_package_version} -f main.Dockerfile --push ./",
    "publish:docker:tiny": "docker buildx build --platform linux/amd64,linux/arm64 -t gyoridavid/short-video-maker:latest-tiny -t gyoridavid/short-video-maker:${npm_package_version}-tiny -f main-tiny.Dockerfile --push ./",
    "ui:dev": "vite",
    "ui:build": "vite build",
    "ui:preview": "vite preview",
    "typecheck:server": "tsc --noEmit -p tsconfig.build.json",
    "typecheck:ui": "tsc --noEmit -p tsconfig.ui.json",
    "typecheck:revideo-project": "tsc --noEmit -p tsconfig.revideo-project.json",
    "typecheck": "npm run typecheck:server && npm run typecheck:ui && npm run typecheck:revideo-project",
    "typecheck:all": "npm run typecheck"
  },
  "bin": {
    "short-video-maker": "dist/index.js"
  },
  "files": [
    "dist",
    "static"
  ],
  "keywords": [
    "shorts",
    "mcp",
    "model context protocol",
    "reels",
    "tiktok",
    "youtube shorts",
    "youtube",
    "short video",
    "video creation",
    "instagram",
    "video",
    "generator",
    "remotion",
    "faceless video"
  ],
  "author": "David Gyori",
  "license": "MIT",
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@fontsource/cairo": "5.3.0",
    "@modelcontextprotocol/sdk": "^1.9.0",
    "@mui/icons-material": "^5.15.10",
    "@mui/material": "^5.15.10",
    "@remotion/bundler": "^4.0.286",
    "@remotion/cli": "^4.0.286",
    "@remotion/google-fonts": "^4.0.286",
    "@remotion/install-whisper-cpp": "^4.0.286",
    "@remotion/renderer": "^4.0.286",
    "@remotion/zod-types": "^4.0.286",
    "@revideo/2d": "0.11.0",
    "@revideo/core": "0.11.0",
    "@revideo/ffmpeg": "0.11.0",
    "@revideo/renderer": "0.11.0",
    "@revideo/ui": "0.11.0",
    "@revideo/vite-plugin": "0.11.0",
    "@tanstack/react-query": "^5.18.0",
    "@types/react-dom": "^19.1.3",
    "@types/react-router-dom": "^5.3.3",
    "axios": "^1.9.0",
    "content-type": "^1.0.5",
    "cuid": "^3.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.3.0",
    "google-auth-library": "^11.0.2",
    "kokoro-js": "^1.2.0",
    "nock": "^14.0.3",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "puppeteer": "25.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.3",
    "remotion": "^4.0.286",
    "stylis": "4.3.2",
    "stylis-plugin-rtl": "2.1.1",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@playwright/test": "1.54.2",
    "@remotion/eslint-config-flat": "^4.0.286",
    "@types/content-type": "^1.1.8",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/fs-extra": "^11.0.4",
    "@types/nock": "^11.1.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.24.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.31",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vitest": "^3.1.1"
  }
}
